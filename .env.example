# ============================================================
# assembleiaDeus - MODELO DE CONFIGURACAO (copiar para .env)
# NUNCA preencher a senha de producao neste arquivo.
# ============================================================

# Aplicacao
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/assembleiaDeus
APP_NAME=Assembleia de Deus
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR

# Banco de dados
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ezyro_43462517_gestao_igreja
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Producao FreeHost/Ezyro (exemplo - NAO colocar a senha real aqui)
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://seudominio.ezyro.com
# DB_HOST=sql303.ezyro.com
# DB_NAME=ezyro_43462517_gestao_igreja
# DB_USER=ezyro_43462517
# DB_PASS=SENHA_DEFINIDA_NO_PAINEL_EZYRO

# E-mail (usado na recuperacao de senha e formulario de contato)
MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Assembleia de Deus

# Seguranca
APP_KEY=troque-por-uma-chave-aleatoria-de-64-caracteres
SESSION_NAME=assembleiadeus_session
